{
  "name": "bapi-benue-agriprice-insight",
  "version": "0.1.0",
  "private": true,
  "description": "Repository for the Benue AgriPrice Insight final-year project.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "build:web": "npm run build --workspace frontend",
    "build:api": "npm run build --workspace backend",
    "build": "npm run build:web && npm run build:api",
    "lint:web": "npm run lint --workspace frontend",
    "lint:api": "npm run lint --workspace backend",
    "lint": "npm run lint:web && npm run lint:api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "typecheck:web": "npm run typecheck --workspace frontend",
    "typecheck:api": "npm run typecheck --workspace backend",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "smoke:check": "node scripts/smoke-check.mjs"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.19.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
