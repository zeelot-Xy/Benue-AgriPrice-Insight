generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  VIEWER
}

enum ImportStatus {
  PENDING
  COMPLETED
  PARTIAL
  FAILED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrendDirection {
  UPWARD
  DOWNWARD
  STABLE
}

enum AlertType {
  PRICE_SPIKE
  PRICE_DROP
  MISSING_DATA
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

model Role {
  id        Int       @id @default(autoincrement())
  name      RoleName  @unique
  users     User[]
  createdAt DateTime  @default(now())
}

model User {
  id                       Int                    @id @default(autoincrement())
  fullName                 String
  email                    String                 @unique
  passwordHash             String
  isActive                 Boolean                @default(true)
  roleId                   Int
  role                     Role                   @relation(fields: [roleId], references: [id])
  importBatches            ImportBatch[]
  createdPrices            PriceRecord[]          @relation("PriceRecordCreatedBy")
  reviewedSubmissionBatches PriceSubmissionBatch[] @relation("PriceSubmissionReviewedBy")
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

model Market {
  id                Int                @id @default(autoincrement())
  name              String
  code              String             @unique
  localGovernmentArea String
  state             String             @default("Benue")
  isActive          Boolean            @default(true)
  priceRecords      PriceRecord[]
  submissionRows    PriceSubmissionRow[]
  analysisSnapshots AnalysisSnapshot[]
  alerts            Alert[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Commodity {
  id                Int                @id @default(autoincrement())
  name              String
  slug              String             @unique
  defaultUnit       String
  isActive          Boolean            @default(true)
  priceRecords      PriceRecord[]
  submissionRows    PriceSubmissionRow[]
  analysisSnapshots AnalysisSnapshot[]
  alerts            Alert[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model ImportBatch {
  id           Int          @id @default(autoincrement())
  fileName     String
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  successRows  Int          @default(0)
  failedRows   Int          @default(0)
  notes        String?
  createdById  Int
  createdBy    User         @relation(fields: [createdById], references: [id])
  priceRecords PriceRecord[]
  createdAt    DateTime     @default(now())
}

model PriceRecord {
  id            Int          @id @default(autoincrement())
  marketId      Int
  commodityId   Int
  createdById   Int?
  importBatchId Int?
  priceDate     DateTime     @db.Date
  price         Decimal      @db.Decimal(12, 2)
  unit          String
  sourceNote    String?
  market        Market       @relation(fields: [marketId], references: [id])
  commodity     Commodity    @relation(fields: [commodityId], references: [id])
  createdBy     User?        @relation("PriceRecordCreatedBy", fields: [createdById], references: [id])
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([marketId, commodityId, priceDate, unit])
  @@index([marketId, commodityId, priceDate])
}

model AnalysisSnapshot {
  id             Int            @id @default(autoincrement())
  marketId       Int
  commodityId    Int
  periodStart    DateTime       @db.Date
  periodEnd      DateTime       @db.Date
  trendDirection TrendDirection
  explanation    String
  summaryPayload Json
  market         Market         @relation(fields: [marketId], references: [id])
  commodity      Commodity      @relation(fields: [commodityId], references: [id])
  createdAt      DateTime       @default(now())

  @@index([marketId, commodityId, periodStart, periodEnd])
}

model Alert {
  id          Int           @id @default(autoincrement())
  marketId    Int
  commodityId Int
  alertType   AlertType
  severity    AlertSeverity
  explanation String
  isActive    Boolean       @default(true)
  market      Market        @relation(fields: [marketId], references: [id])
  commodity   Commodity     @relation(fields: [commodityId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([marketId, commodityId, alertType, isActive])
}

model PriceSubmissionBatch {
  id             Int                  @id @default(autoincrement())
  publicReferenceCode String          @unique
  fileName       String
  submitterName  String?
  submitterEmail String?
  sourceChannel  String               @default("PUBLIC_UPLOAD")
  status         SubmissionStatus     @default(PENDING)
  totalRows      Int                  @default(0)
  validRows      Int                  @default(0)
  invalidRows    Int                  @default(0)
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   Int?
  reviewedBy     User?                @relation("PriceSubmissionReviewedBy", fields: [reviewedById], references: [id])
  rows           PriceSubmissionRow[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, createdAt])
}

model PriceSubmissionRow {
  id            Int                 @id @default(autoincrement())
  batchId       Int
  marketId      Int
  commodityId   Int
  marketCode    String
  commoditySlug String
  priceDate     DateTime            @db.Date
  price         Decimal             @db.Decimal(12, 2)
  unit          String
  sourceNote    String?
  batch         PriceSubmissionBatch @relation(fields: [batchId], references: [id])
  market        Market              @relation(fields: [marketId], references: [id])
  commodity     Commodity           @relation(fields: [commodityId], references: [id])
  createdAt     DateTime            @default(now())

  @@index([batchId])
  @@index([marketId, commodityId, priceDate])
}
